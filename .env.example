# Copy this file to ".env" (same folder) and fill in your own values.
# The real ".env" is ignored by Git, so your token is never uploaded. Never share it.
# Help: python telegram_notify.py   (shows the setup steps)

# From @BotFather in Telegram (/newbot). Anyone with this token can send messages as your bot.
TELEGRAM_BOT_TOKEN=

# Your group or channel id. Find it with:  python telegram_notify.py --find-chat
# (a group id is a negative number, for example -1001234567890)
TELEGRAM_CHAT_ID=

# Free Yahoo data is about 15 minutes late. Alerts are sent anyway, and each one says "DELAYED DATA".
# To send NOTHING on old data (the entry moment has usually passed), remove the "#" in the next line.
# TELEGRAM_ALLOW_DELAYED=0

# Optional. Markets the dashboard watches for alerts, and the data source (yahoo or angel).
# Default: angel when the ANGEL_* values below are filled in, otherwise yahoo.
# ALERT_MARKETS=nifty:5m,sensex:5m
# ALERT_SOURCE=angel

# Angel One SmartAPI (live data, longer history, real option prices). Read-only use.
# ANGEL_API_KEY=
# ANGEL_CLIENT_ID=
# ANGEL_PIN=
# ANGEL_TOTP_SECRET=
